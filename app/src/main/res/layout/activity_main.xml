<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Фитнес-трекер отжиманий"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="12dp" />

        <TextView
            android:id="@+id/tvHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Положите телефон экраном вверх на пол под грудь. В нижней точке отжимания слегка коснитесь/заденьте телефон — акселерометр зафиксирует характерное движение и засчитает повторение."
            android:textSize="15sp"
            android:lineSpacingExtra="4dp"
            android:paddingBottom="18dp" />

        <TextView
            android:id="@+id/tvCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0"
            android:textSize="72sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvGoal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Цель: 10 отжиманий"
            android:textSize="18sp"
            android:gravity="center"
            android:paddingBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Цель: "
                android:textSize="16sp" />

            <EditText
                android:id="@+id/etGoal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="number"
                android:text="10"
                android:singleLine="true" />

            <Button
                android:id="@+id/btnSaveGoal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ОК" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvThreshold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Чувствительность: 2.5 м/с²"
            android:textSize="16sp"
            android:paddingBottom="6dp" />

        <SeekBar
            android:id="@+id/seekThreshold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="50"
            android:progress="15"
            android:paddingBottom="18dp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Статус: нажмите «Старт»"
            android:textSize="16sp"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/tvSensor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Акселерометр: проверка..."
            android:textSize="16sp"
            android:paddingBottom="18dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnStart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Старт" />

            <Button
                android:id="@+id/btnReset"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Сброс" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
